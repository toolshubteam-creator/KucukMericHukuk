@using KucukMericHukuk.Core.Enums
@model KucukMericHukuk.Core.DTOs.Appointment.AppointmentAdminDto
@inject Microsoft.Extensions.Options.IOptions<KucukMericHukuk.Infrastructure.Email.EmailSettings> EmailOptions
@{
    ViewData["Title"] = $"Randevu Talebi #{Model.Id}";
    var smtpConfigured = !string.IsNullOrWhiteSpace(EmailOptions.Value.SmtpHost);

    var (badgeCss, badgeLabel) = Model.Status switch
    {
        AppointmentStatus.Confirmed => ("bg-success-lt", "Onaylandı"),
        AppointmentStatus.Rejected => ("bg-danger-lt", "Reddedildi"),
        AppointmentStatus.Completed => ("bg-secondary-lt", "Tamamlandı"),
        _ => ("bg-warning-lt", "Bekliyor")
    };
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Appointments" asp-area="Admin">Randevu Talepleri</a>
                    </li>
                    <li class="breadcrumb-item active">@Model.Subject</li>
                </ol>
            </nav>
            <h2 class="page-title">@Model.Subject</h2>
            <div class="text-secondary mt-1">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
        </div>
        <div class="col-auto">
            <a asp-action="Index" asp-controller="Appointments" asp-area="Admin" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
                    @if (Model.IsDeleted)
                    {
                        <span class="badge bg-danger-lt">Silinmiş</span>
                    }
                    else
                    {
                        <span class="badge @badgeCss">@badgeLabel</span>
                    }

                    @if (Model.KvkkConsent)
                    {
                        <span class="badge bg-secondary-lt">KVKK Onaylandı</span>
                    }
                </div>

                <h4>Tercih Edilen Randevu</h4>
                <dl class="row">
                    <dt class="col-sm-3">Tarih</dt>
                    <dd class="col-sm-9">@Model.PreferredDate.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-3">Saat</dt>
                    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.PreferredTimeNote) ? "-" : Model.PreferredTimeNote)</dd>
                </dl>

                <h4 class="mt-3">Ek Açıklama</h4>
                <div class="message-body p-3 bg-light rounded" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(Model.Notes) ? "(açıklama girilmemiş)" : Model.Notes)</div>

                @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                {
                    <h4 class="mt-3">Yönetici Notu</h4>
                    <div class="message-body p-3 bg-light rounded" style="white-space: pre-wrap;">@Model.AdminNote</div>
                }
            </div>
        </div>

        @if (!Model.IsDeleted)
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title mb-0">Durum Yönetimi</h3>
                </div>
                <div class="card-body">
                    @if (!smtpConfigured)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>SMTP yapılandırılmamış:</strong> Durum güncellenir ancak müvekkile e-posta gönderilmez.
                            <code>EmailSettings:SmtpHost</code> appsettings veya environment variable ile tanımlayın.
                        </div>
                    }

                    <form asp-action="Confirm" asp-controller="Appointments" asp-area="Admin"
                          asp-route-id="@Model.Id" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label for="confirm-note" class="form-label">Onay notu (opsiyonel)</label>
                            <textarea id="confirm-note" name="adminNote" class="form-control" rows="3"
                                      maxlength="2000"
                                      placeholder="Müvekkile gidecek onay e-postasına eklenecek açıklama..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success">
                            <i class="ti ti-check me-1"></i> Onayla ve Bilgilendir
                        </button>
                    </form>

                    <form asp-action="Reject" asp-controller="Appointments" asp-area="Admin"
                          asp-route-id="@Model.Id" method="post" class="mb-4">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label for="reject-note" class="form-label">Red gerekçesi (opsiyonel)</label>
                            <textarea id="reject-note" name="adminNote" class="form-control" rows="3"
                                      maxlength="2000"
                                      placeholder="Müvekkile gidecek red e-postasına eklenecek açıklama..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="ti ti-x me-1"></i> Reddet ve Bilgilendir
                        </button>
                    </form>

                    <div class="d-flex gap-2 flex-wrap border-top pt-3">
                        <form asp-action="Complete" asp-controller="Appointments" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-secondary">
                                <i class="ti ti-checkbox me-1"></i> Tamamlandı işaretle
                            </button>
                        </form>
                        <form asp-action="Delete" asp-controller="Appointments" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline"
                              data-confirm="Bu randevu talebini silmek istediğinizden emin misiniz? Daha sonra geri yükleyebilirsiniz."
                              data-confirm-title="Randevu Talebini Sil"
                              data-confirm-button="Sil">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-trash me-1"></i> Sil
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mt-3">
                <div class="card-body">
                    <form asp-action="Restore" asp-controller="Appointments" asp-area="Admin"
                          asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success">
                            <i class="ti ti-restore me-1"></i> Geri Yükle
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title mb-0">Talep Eden Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title mb-0">Teknik Bilgiler</h3></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">IP Adresi</dt>
                    <dd class="col-sm-7">@(Model.IpAddress ?? "-")</dd>

                    <dt class="col-sm-5">Tarayıcı</dt>
                    <dd class="col-sm-7 text-break">@(Model.UserAgent ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
