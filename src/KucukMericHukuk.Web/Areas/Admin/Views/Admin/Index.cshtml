@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Kontrol Paneli";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <h2 class="page-title">Kontrol Paneli</h2>
            <div class="text-secondary">Hoş geldiniz. Yönetim paneline genel bakış.</div>
        </div>
    </div>
</div>

<div class="row row-deck row-cards mt-3">
    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">İletişim Mesajları</h3>
                <div class="card-actions">
                    <a asp-action="Index" asp-controller="ContactMessages" asp-area="Admin"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="ti ti-mail me-1"></i> Tümü
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <span class="bg-warning-lt text-warning avatar avatar-lg">
                            <i class="ti ti-mail-opened"></i>
                        </span>
                    </div>
                    <div>
                        <div class="h1 mb-0">@Model.Messages.UnreadCount</div>
                        <div class="text-secondary">okunmamış mesaj</div>
                    </div>
                </div>

                @if (Model.Messages.RecentMessages.Any())
                {
                    <h5 class="text-secondary mb-2 mt-3">Son mesajlar</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var m in Model.Messages.RecentMessages)
                        {
                            var rowClass = !m.IsRead ? "fw-bold" : "";
                            <li class="mb-2 pb-2 border-bottom">
                                <a asp-action="Details" asp-controller="ContactMessages" asp-area="Admin"
                                   asp-route-id="@m.Id" class="text-decoration-none">
                                    <div class="@rowClass">@m.Name <span class="text-secondary fw-normal">— @m.Subject</span></div>
                                    <small class="text-secondary">@m.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-secondary mb-0">Henüz iletişim mesajı yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Makaleler</h3>
                <div class="card-actions">
                    <a asp-action="Index" asp-controller="Articles" asp-area="Admin"
                       class="btn btn-sm btn-outline-secondary">
                        <i class="ti ti-news me-1"></i> Tümü
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="me-3">
                        <span class="bg-primary-lt text-primary avatar avatar-lg">
                            <i class="ti ti-news"></i>
                        </span>
                    </div>
                    <div>
                        <div class="h1 mb-0">@Model.Articles.TotalCount</div>
                        <div class="text-secondary">toplam makale</div>
                    </div>
                </div>

                @if (Model.Articles.RecentArticles.Any())
                {
                    <h5 class="text-secondary mb-2 mt-3">Son yayınlananlar</h5>
                    <ul class="list-unstyled mb-0">
                        @foreach (var a in Model.Articles.RecentArticles)
                        {
                            <li class="mb-2 pb-2 border-bottom">
                                <a asp-action="Edit" asp-controller="Articles" asp-area="Admin"
                                   asp-route-id="@a.Id" class="text-decoration-none">
                                    <div>@a.Title</div>
                                    @if (a.PublishedAt.HasValue)
                                    {
                                        <small class="text-secondary">@a.PublishedAt.Value.ToString("dd.MM.yyyy HH:mm")</small>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-secondary mb-0">Henüz yayınlanmış makale yok.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Site Özeti</h3>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-news me-2 text-secondary"></i>Makaleler</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.ArticleCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-briefcase me-2 text-secondary"></i>Hizmetler</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.ServiceCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-users me-2 text-secondary"></i>Avukatlar</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.AttorneyCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-file-text me-2 text-secondary"></i>Sayfalar</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.PageCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-photo me-2 text-secondary"></i>Medya</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.MediaCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-message-question me-2 text-secondary"></i>SSS</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.FaqCount</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span><i class="ti ti-quote me-2 text-secondary"></i>Referanslar</span>
                        <span class="badge bg-secondary-lt">@Model.SiteSummary.TestimonialCount</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
