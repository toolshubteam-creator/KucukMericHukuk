@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Medias.MediaEditFormViewModel
@{
    ViewData["Title"] = "Medya Düzenle";
    var media = ViewBag.Media as KucukMericHukuk.Core.DTOs.Media.MediaFileDto;
}

<div class="page-header d-print-none">
    <h2 class="page-title">Medya Düzenle</h2>
</div>

<div class="row mt-3">
    @if (media is not null)
    {
        <div class="col-md-5">
            <div class="card">
                <div class="card-body text-center">
                    <img src="@media.Url" alt="@(media.AltText ?? media.OriginalFileName)" class="media-detail-image" />
                </div>
                <div class="card-footer text-secondary small">
                    @media.OriginalFileName — @media.Width × @media.Height
                </div>
            </div>
        </div>
    }
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-controller="Medias" asp-area="Admin" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="AltText" class="form-label"></label>
                        <input asp-for="AltText" class="form-control" maxlength="500" />
                        <span asp-validation-for="AltText" class="invalid-feedback d-block"></span>
                        <small class="text-secondary">SEO ve erişilebilirlik için görseli kısaca tanımlayın.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input asp-for="IsPublic" class="form-check-input" />
                            <span class="form-check-label">Galeride göster (public)</span>
                        </label>
                        <small class="text-secondary d-block mt-1">
                            Açık: /Galeri sayfasında görünür. Kapalı: yalnızca admin panelinde.
                        </small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i> Kaydet
                        </button>
                        <a asp-action="Details" asp-controller="Medias" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-outline-secondary">İptal</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
