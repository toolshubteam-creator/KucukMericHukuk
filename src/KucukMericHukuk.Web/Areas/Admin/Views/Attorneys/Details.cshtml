@model KucukMericHukuk.Core.DTOs.Attorney.AttorneyAdminDto
@{
    var firstName = Model.Translations?.FirstOrDefault()?.FullName ?? "(adsız)";
    ViewData["Title"] = $"Avukat: {firstName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/components/page-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/attorney-form.css" asp-append-version="true" />
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Attorneys" asp-area="Admin">Avukatlarımız</a>
                    </li>
                    <li class="breadcrumb-item active">@firstName</li>
                </ol>
            </nav>
            <h2 class="page-title">@firstName</h2>
        </div>
        <div class="col-auto">
            @if (!Model.IsDeleted)
            {
                <a asp-action="Edit" asp-controller="Attorneys" asp-area="Admin"
                   asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i> Düzenle
                </a>
                @* Sil — Faz 2.9c'de aktif edilecek *@
                <button type="button" class="btn btn-outline-danger ms-1" disabled>
                    <i class="ti ti-trash me-1"></i> Sil (Faz 2.9c)
                </button>
            }
            else
            {
                @* Restore + HardDelete — Faz 2.9c'de aktif edilecek *@
                <button type="button" class="btn btn-outline-success" disabled>
                    <i class="ti ti-restore me-1"></i> Geri Yükle (Faz 2.9c)
                </button>
                <button type="button" class="btn btn-danger ms-1" disabled>
                    <i class="ti ti-x me-1"></i> Tamamen Sil (Faz 2.9c)
                </button>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Profil Fotoğrafı</h3>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="@firstName" class="rounded attorney-photo-preview" />
                }
                else
                {
                    <div class="text-secondary py-4">
                        <i class="ti ti-user attorney-photo-placeholder"></i>
                        <div class="mt-2">Foto yok</div>
                    </div>
                }
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Genel Bilgiler</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Sıra</dt>
                    <dd class="col-7">@Model.DisplayOrder</dd>

                    <dt class="col-5">Durum</dt>
                    <dd class="col-7">
                        @if (Model.IsDeleted)
                        {
                            <span class="badge bg-danger-lt">Silinmiş</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Pasif</span>
                        }
                    </dd>

                    <dt class="col-5">Bağlı Kullanıcı</dt>
                    <dd class="col-7">
                        @if (Model.UserId.HasValue)
                        {
                            <span>@(Model.UserEmail ?? $"User #{Model.UserId}")</span>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </dd>

                    <dt class="col-5">Oluşturulma</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-5">Güncellenme</dt>
                        <dd class="col-7">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Kişisel Bilgiler</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Baro Sicil</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.BarRegistrationNumber) ? "—" : Model.BarRegistrationNumber)</dd>

                    <dt class="col-5">Baro Adı</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.BarName) ? "—" : Model.BarName)</dd>

                    <dt class="col-5">E-posta</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </dd>

                    <dt class="col-5">Telefon</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>

                    <dt class="col-5">LinkedIn</dt>
                    <dd class="col-7">
                        @if (!string.IsNullOrWhiteSpace(Model.LinkedInUrl))
                        {
                            <a href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer">Profil</a>
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Bağlı Hizmetler (@(Model.Services?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Services is null || Model.Services.Count == 0)
                {
                    <p class="text-secondary mb-0">Bu avukat hiçbir hizmete bağlı değil.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var service in Model.Services)
                        {
                            <span class="badge bg-blue-lt">@service.Name</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Çeviriler (@(Model.Translations?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Translations is null || Model.Translations.Count == 0)
                {
                    <p class="text-secondary mb-0">Henüz çeviri eklenmemiş.</p>
                }
                else
                {
                    <div class="accordion" id="attorneyTranslationsAccordion">
                        @{ var idx = 0; }
                        @foreach (var t in Model.Translations)
                        {
                            var collopseId = $"atttrans-{idx}";
                            <div class="accordion-item">
                                <h4 class="accordion-header">
                                    <button class="accordion-button @(idx > 0 ? "collapsed" : "")"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#@collopseId"
                                            aria-expanded="@(idx == 0 ? "true" : "false")">
                                        <span class="badge bg-blue-lt me-2">@t.LanguageCode</span>
                                        @t.FullName
                                    </button>
                                </h4>
                                <div id="@collopseId"
                                     class="accordion-collapse collapse @(idx == 0 ? "show" : "")"
                                     data-bs-parent="#attorneyTranslationsAccordion">
                                    <div class="accordion-body">
                                        <dl class="row">
                                            <dt class="col-3">Ad Soyad</dt>
                                            <dd class="col-9">@t.FullName</dd>

                                            <dt class="col-3">Ünvan</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.Title) ? "—" : t.Title)</dd>

                                            <dt class="col-3">Slug</dt>
                                            <dd class="col-9"><code>@t.Slug</code></dd>

                                            <dt class="col-3">Kısa Bio</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.ShortBio) ? "—" : t.ShortBio)</dd>

                                            <dt class="col-3">Detaylı Bio</dt>
                                            <dd class="col-9">
                                                @* FullBio HtmlSanitizer'dan geçti (AttorneyService.BuildTranslation) *@
                                                <div class="border rounded p-2 bg-light">
                                                    <div class="page-content-preview">
                                                        @Html.Raw(t.FullBio)
                                                    </div>
                                                </div>
                                            </dd>

                                            <dt class="col-3">Eğitim</dt>
                                            <dd class="col-9">
                                                @if (string.IsNullOrWhiteSpace(t.Education))
                                                {
                                                    <span class="text-secondary">—</span>
                                                }
                                                else
                                                {
                                                    <div class="attorney-multiline">@t.Education</div>
                                                }
                                            </dd>

                                            <dt class="col-3">Yayınlar</dt>
                                            <dd class="col-9">
                                                @if (string.IsNullOrWhiteSpace(t.Publications))
                                                {
                                                    <span class="text-secondary">—</span>
                                                }
                                                else
                                                {
                                                    <div class="attorney-multiline">@t.Publications</div>
                                                }
                                            </dd>

                                            <dt class="col-3">Meta Başlık</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaTitle) ? "—" : t.MetaTitle)</dd>

                                            <dt class="col-3">Meta Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaDescription) ? "—" : t.MetaDescription)</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
