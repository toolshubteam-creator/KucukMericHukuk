@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Attorneys.AttorneyFormViewModel
@{
    ViewData["Title"] = "Yeni Avukat";
}

@section Styles {
    <partial name="_QuillStyles" />
    <link rel="stylesheet" href="~/css/admin/components/attorney-form.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Attorneys" asp-area="Admin">Avukatlarımız</a>
                    </li>
                    <li class="breadcrumb-item active">Yeni Avukat</li>
                </ol>
            </nav>
            <h2 class="page-title">Yeni Avukat</h2>
        </div>
    </div>
</div>

<form asp-action="Create" asp-controller="Attorneys" asp-area="Admin" method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_AttorneyForm" model="Model" />

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Index" asp-controller="Attorneys" asp-area="Admin" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-plus me-1"></i> Oluştur
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_QuillScripts" />
}
