@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Attorneys.AttorneyFormViewModel

<div class="row mt-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Sistem</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="DisplayOrder" class="form-label"></label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                    <span asp-validation-for="DisplayOrder" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" />
                        <span class="form-check-label">Aktif</span>
                    </label>
                </div>

                <div class="mb-3">
                    <label asp-for="UserId" class="form-label"></label>
                    <select asp-for="UserId" class="form-select">
                        <option value="">— (Bağlı kullanıcı yok)</option>
                        @foreach (var u in Model.AvailableUsers)
                        {
                            <option value="@u.Id" selected="@(Model.UserId == u.Id)">@u.Name</option>
                        }
                    </select>
                    <span asp-validation-for="UserId" class="invalid-feedback d-block"></span>
                    <small class="form-hint">Avukatın siteye giriş yapması için kullanıcı seçin (opsiyonel).</small>
                </div>

                <div class="mb-3">
                    <label asp-for="ProfileImageUrl" class="form-label"></label>
                    <input asp-for="ProfileImageUrl" class="form-control" maxlength="500" />
                    <span asp-validation-for="ProfileImageUrl" class="invalid-feedback d-block"></span>
                    <small class="form-hint">Görsel URL (Faz 3'te medya yöneticisi eklenecek).</small>

                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ProfileImageUrl" alt="Profil önizleme" class="rounded attorney-photo-preview" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Kişisel Bilgiler</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="BarRegistrationNumber" class="form-label"></label>
                    <input asp-for="BarRegistrationNumber" class="form-control" maxlength="50" />
                    <span asp-validation-for="BarRegistrationNumber" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="BarName" class="form-label"></label>
                    <input asp-for="BarName" class="form-control" maxlength="150"
                           placeholder="Sakarya Barosu, İstanbul Barosu, vb." />
                    <span asp-validation-for="BarName" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" maxlength="150" />
                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" maxlength="50" />
                    <span asp-validation-for="PhoneNumber" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LinkedInUrl" class="form-label"></label>
                    <input asp-for="LinkedInUrl" type="url" class="form-control" maxlength="300" />
                    <span asp-validation-for="LinkedInUrl" class="invalid-feedback d-block"></span>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Bağlı Hizmetler</h3>
            </div>
            <div class="card-body">
                @if (Model.AvailableServices.Count == 0)
                {
                    <p class="text-secondary mb-0">
                        Henüz aktif hizmet yok. Önce <a asp-action="Index" asp-controller="Services" asp-area="Admin">Hizmetler</a> sayfasından ekleyin.
                    </p>
                }
                else
                {
                    @foreach (var svc in Model.AvailableServices)
                    {
                        <label class="form-check">
                            <input type="checkbox" name="ServiceIds" value="@svc.Id"
                                   class="form-check-input"
                                   @(Model.ServiceIds.Contains(svc.Id) ? "checked" : "") />
                            <span class="form-check-label">@svc.Name</span>
                        </label>
                    }
                }

                <span asp-validation-for="ServiceIds" class="invalid-feedback d-block mt-2"></span>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Çeviriler</h3>
            </div>
            <div class="card-body">
                <partial name="_AttorneyLanguageTabs" model="Model" />
            </div>
        </div>
    </div>
</div>
