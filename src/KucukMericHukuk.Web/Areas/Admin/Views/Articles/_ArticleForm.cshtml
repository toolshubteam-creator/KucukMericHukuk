@using KucukMericHukuk.Core.Enums
@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel

<div class="row mt-3">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">İçerik</h3>
            </div>
            <div class="card-body">
                <partial name="_ArticleLanguageTabs" model="Model" />
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Yayın</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="@((int)ArticleStatus.Draft)">Taslak</option>
                        <option value="@((int)ArticleStatus.Published)">Yayında</option>
                        <option value="@((int)ArticleStatus.Archived)">Arşivlendi</option>
                    </select>
                    <span asp-validation-for="Status" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PublishedAt" class="form-label"></label>
                    <input asp-for="PublishedAt" class="form-control" type="datetime-local"
                           value="@(Model.PublishedAt?.ToString("yyyy-MM-ddTHH:mm"))" />
                    <span asp-validation-for="PublishedAt" class="invalid-feedback d-block"></span>
                    <small class="form-hint">Boş bırakılırsa "Yayında"ya geçtiğinizde otomatik şu an atanır.</small>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <span class="form-check-label">Öne Çıkar</span>
                    </label>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Sınıflandırma</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select">
                        <option value="">(seçilmedi)</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TagIds" class="form-label"></label>
                    <select asp-for="TagIds" class="form-select" multiple data-choices>
                        @foreach (var tag in Model.AvailableTags)
                        {
                            <option value="@tag.Id" selected="@(Model.TagIds.Contains(tag.Id))">@tag.Name</option>
                        }
                    </select>
                    <span asp-validation-for="TagIds" class="invalid-feedback d-block"></span>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Öne Çıkan Görsel</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="input-group">
                        <input asp-for="FeaturedImageUrl" id="ArticleFeaturedImageUrl"
                               class="form-control" maxlength="500" />
                        <button type="button" class="btn btn-outline-secondary"
                                data-media-picker-target="#ArticleFeaturedImageUrl"
                                data-media-preview="#ArticleFeaturedImagePreview">
                            <i class="ti ti-photo me-1"></i> Galeriden Seç
                        </button>
                    </div>
                    <span asp-validation-for="FeaturedImageUrl" class="invalid-feedback d-block"></span>
                    <div class="mt-2">
                        @if (!string.IsNullOrWhiteSpace(Model.FeaturedImageUrl))
                        {
                            <img id="ArticleFeaturedImagePreview" src="@Model.FeaturedImageUrl"
                                 alt="Önizleme" class="rounded service-featured-preview" />
                        }
                        else
                        {
                            <img id="ArticleFeaturedImagePreview" src="" alt=""
                                 class="rounded service-featured-preview" hidden />
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" asp-for="AuthorId" />
<input type="hidden" asp-for="AuthorName" />
