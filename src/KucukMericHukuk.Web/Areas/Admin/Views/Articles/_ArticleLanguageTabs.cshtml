@using KucukMericHukuk.Core.Constants
@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel
@{
    var supportedLanguages = LanguageCodes.Supported;
}

<ul class="nav nav-tabs mb-3" role="tablist">
    @{
        var firstTab = true;
        foreach (var lang in supportedLanguages)
        {
            var tabId = $"artlang-{lang.Replace("-", "_")}";
            <li class="nav-item" role="presentation">
                <a class="nav-link @(firstTab ? "active" : "")"
                   data-bs-toggle="tab" href="#@tabId" role="tab">@lang</a>
            </li>
            firstTab = false;
        }
    }
</ul>

<div class="tab-content">
    @{
        var firstPane = true;
        for (var i = 0; i < Model.Translations.Count; i++)
        {
            var t = Model.Translations[i];
            var tabId = $"artlang-{t.LanguageCode.Replace("-", "_")}";
            var titleId = $"Translations_{i}__Title";
            var slugId = $"Translations_{i}__Slug";

            <div class="tab-pane fade @(firstPane ? "show active" : "")" id="@tabId" role="tabpanel">
                <input type="hidden" asp-for="Translations[i].LanguageCode" />
                <input type="hidden" asp-for="Translations[i].Id" />

                <div class="mb-3">
                    <label asp-for="Translations[i].Title" class="form-label required"></label>
                    <input asp-for="Translations[i].Title" id="@titleId" class="form-control"
                           maxlength="300"
                           data-slug-source="#@slugId" />
                    <span asp-validation-for="Translations[i].Title" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Translations[i].Slug" class="form-label"></label>
                    <input asp-for="Translations[i].Slug" id="@slugId" class="form-control"
                           placeholder="boş bırakılırsa başlıktan otomatik üretilir" maxlength="300" />
                    <span asp-validation-for="Translations[i].Slug" class="invalid-feedback d-block"></span>
                    <small class="form-hint">Yalnızca küçük harf, rakam ve tire.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Translations[i].Excerpt" class="form-label"></label>
                    <textarea asp-for="Translations[i].Excerpt" class="form-control"
                              rows="2" maxlength="500"
                              placeholder="boş bırakılırsa içerikten ilk 160 karakter alınır"></textarea>
                    <span asp-validation-for="Translations[i].Excerpt" class="invalid-feedback d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Translations[i].Content" class="form-label required"></label>
                    <textarea asp-for="Translations[i].Content"
                              class="form-control"
                              data-quill-target="true"
                              rows="14"></textarea>
                    <span asp-validation-for="Translations[i].Content" class="invalid-feedback d-block"></span>
                </div>

                <div class="accordion" id="article-seo-accordion-@i">
                    <div class="accordion-item">
                        <h4 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#article-seo-@i"
                                    aria-expanded="false">
                                SEO
                            </button>
                        </h4>
                        <div id="article-seo-@i" class="accordion-collapse collapse"
                             data-bs-parent="#article-seo-accordion-@i">
                            <div class="accordion-body">
                                <div class="mb-3">
                                    <label asp-for="Translations[i].MetaTitle" class="form-label"></label>
                                    <input asp-for="Translations[i].MetaTitle" class="form-control" maxlength="200" />
                                    <span asp-validation-for="Translations[i].MetaTitle" class="invalid-feedback d-block"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Translations[i].MetaDescription" class="form-label"></label>
                                    <textarea asp-for="Translations[i].MetaDescription" class="form-control"
                                              maxlength="500" rows="3"></textarea>
                                    <span asp-validation-for="Translations[i].MetaDescription" class="invalid-feedback d-block"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            firstPane = false;
        }
    }
</div>
