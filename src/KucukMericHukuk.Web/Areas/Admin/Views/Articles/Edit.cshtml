@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Articles.ArticleFormViewModel
@{
    ViewData["Title"] = "Makale Düzenle";
    var firstTitle = Model.Translations?.FirstOrDefault()?.Title ?? "(adsız)";
}

@section Styles {
    <partial name="_QuillStyles" />
    @* Choices.js CSS — 11.1.0 self-host (Faz 6.17, libman) *@
    <link rel="stylesheet" href="~/lib/choices/public/assets/styles/choices.min.css" asp-append-version="true" />
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Articles" asp-area="Admin">Makaleler</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-controller="Articles" asp-area="Admin"
                           asp-route-id="@Model.Id">@firstTitle</a>
                    </li>
                    <li class="breadcrumb-item active">Düzenle</li>
                </ol>
            </nav>
            <h2 class="page-title">Makale Düzenle: @firstTitle</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-controller="Articles" asp-area="Admin" asp-route-id="@Model.Id"
      method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_ArticleForm" model="Model" />

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Details" asp-controller="Articles" asp-area="Admin"
           asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-check me-1"></i> Güncelle
        </button>
    </div>
</form>

@section Scripts {
    @* Choices.js — 11.1.0 self-host (Faz 6.17) *@
    <script src="~/lib/choices/public/assets/scripts/choices.min.js" asp-append-version="true"></script>
    <partial name="_QuillScripts" />
    <partial name="_MediaPickerModal" />
    <script src="~/js/admin/media-picker.js" asp-append-version="true"></script>
    <script src="~/js/admin/media-picker-binder.js" asp-append-version="true"></script>
    <script src="~/js/admin/choices-init.js" asp-append-version="true"></script>
    <script src="~/js/admin/slug-from-title.js" asp-append-version="true"></script>
}
