@model KucukMericHukuk.Core.DTOs.Service.ServiceAdminDto
@{
    ViewData["Title"] = $"Hizmet: {Model.Translations?.FirstOrDefault()?.Name ?? "(adsız)"}";
    var firstName = Model.Translations?.FirstOrDefault()?.Name ?? "(adsız)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/components/page-details.css" asp-append-version="true" />
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Services" asp-area="Admin">Hizmetler</a>
                    </li>
                    <li class="breadcrumb-item active">@firstName</li>
                </ol>
            </nav>
            <h2 class="page-title">@firstName</h2>
        </div>
        <div class="col-auto">
            @if (!Model.IsDeleted)
            {
                <a asp-action="Edit" asp-controller="Services" asp-area="Admin"
                   asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i> Düzenle
                </a>
                <form asp-action="Delete" asp-controller="Services" asp-area="Admin"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline ms-1"
                      data-confirm="Bu hizmeti silmek istediğinizden emin misiniz? Daha sonra geri yükleyebilirsiniz."
                      data-confirm-title="Hizmeti Sil"
                      data-confirm-button="Sil">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="ti ti-trash me-1"></i> Sil
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Restore" asp-controller="Services" asp-area="Admin"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">
                        <i class="ti ti-restore me-1"></i> Geri Yükle
                    </button>
                </form>
                <form asp-action="HardDelete" asp-controller="Services" asp-area="Admin"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline ms-1"
                      data-confirm="Bu hizmet ve tüm çevirileri KALICI olarak silinecek. Bu işlem GERİ ALINAMAZ. Devam edilsin mi?"
                      data-confirm-title="Kalıcı Silme"
                      data-confirm-button="Tamamen Sil"
                      data-confirm-variant="danger">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="ti ti-x me-1"></i> Tamamen Sil
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Genel Bilgiler</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Sıra</dt>
                    <dd class="col-7">@Model.DisplayOrder</dd>

                    <dt class="col-5">Durum</dt>
                    <dd class="col-7">
                        @if (Model.IsDeleted)
                        {
                            <span class="badge bg-danger-lt">Silinmiş</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Pasif</span>
                        }
                    </dd>

                    <dt class="col-5">İkon</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.Icon) ? "—" : Model.Icon)</dd>

                    <dt class="col-5">Görsel</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.FeaturedImage) ? "—" : Model.FeaturedImage)</dd>

                    <dt class="col-5">Oluşturulma</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-5">Güncellenme</dt>
                        <dd class="col-7">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Bağlı Avukatlar (@(Model.Attorneys?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Attorneys is null || Model.Attorneys.Count == 0)
                {
                    <p class="text-secondary mb-0">Bu hizmete avukat bağlanmamış.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var attorney in Model.Attorneys)
                        {
                            <span class="badge bg-blue-lt">@attorney.Name</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Çeviriler (@(Model.Translations?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Translations is null || Model.Translations.Count == 0)
                {
                    <p class="text-secondary mb-0">Henüz çeviri eklenmemiş.</p>
                }
                else
                {
                    <div class="accordion" id="serviceTranslationsAccordion">
                        @{ var idx = 0; }
                        @foreach (var t in Model.Translations)
                        {
                            var collapseId = $"svctrans-{idx}";
                            <div class="accordion-item">
                                <h4 class="accordion-header">
                                    <button class="accordion-button @(idx > 0 ? "collapsed" : "")"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="@(idx == 0 ? "true" : "false")">
                                        <span class="badge bg-blue-lt me-2">@t.LanguageCode</span>
                                        @t.Name
                                    </button>
                                </h4>
                                <div id="@collapseId"
                                     class="accordion-collapse collapse @(idx == 0 ? "show" : "")"
                                     data-bs-parent="#serviceTranslationsAccordion">
                                    <div class="accordion-body">
                                        <dl class="row">
                                            <dt class="col-3">Ad</dt>
                                            <dd class="col-9">@t.Name</dd>

                                            <dt class="col-3">Slug</dt>
                                            <dd class="col-9"><code>@t.Slug</code></dd>

                                            <dt class="col-3">Kısa Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.ShortDescription) ? "—" : t.ShortDescription)</dd>

                                            <dt class="col-3">Detaylı Açıklama</dt>
                                            <dd class="col-9">
                                                @* Service'te FullDescription HtmlSanitizer'dan geçti (Faz 2.7a). *@
                                                <div class="border rounded p-2 bg-light">
                                                    <div class="page-content-preview">
                                                        @Html.Raw(t.FullDescription)
                                                    </div>
                                                </div>
                                            </dd>

                                            <dt class="col-3">Meta Başlık</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaTitle) ? "—" : t.MetaTitle)</dd>

                                            <dt class="col-3">Meta Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaDescription) ? "—" : t.MetaDescription)</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
