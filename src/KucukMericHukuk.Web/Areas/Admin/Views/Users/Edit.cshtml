@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Users.UserEditFormViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<div class="page-header">
    <nav aria-label="breadcrumbs">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Users" asp-area="Admin">Kullanıcılar</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.Id">@Model.UserName</a></li>
            <li class="breadcrumb-item active">Düzenle</li>
        </ol>
    </nav>
    <h2 class="page-title">Kullanıcı Düzenle: @Model.UserName</h2>
</div>

<form asp-action="Edit" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.Id" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card mt-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label required"></label>
                    <input asp-for="UserName" class="form-control" maxlength="100" />
                    <span asp-validation-for="UserName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label required"></label>
                    <input asp-for="Email" type="email" class="form-control" maxlength="256" />
                    <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" maxlength="150" />
                    <span asp-validation-for="FullName" class="invalid-feedback d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label required"></label>
                    @if (Model.IsSelf)
                    {
                        <select class="form-select" disabled>
                            <option selected>@Model.Role</option>
                        </select>
                        <input type="hidden" asp-for="Role" />
                        <small class="form-hint text-warning">Kendi rolünüzü değiştiremezsiniz.</small>
                    }
                    else
                    {
                        <select asp-for="Role" class="form-select">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                if (Model.Role == role)
                                {
                                    <option value="@role" selected>@role</option>
                                }
                                else
                                {
                                    <option value="@role">@role</option>
                                }
                            }
                        </select>
                    }
                    <span asp-validation-for="Role" class="invalid-feedback d-block"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex">
            <a asp-action="Details" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
            <button type="submit" class="btn btn-primary ms-auto">
                <i class="ti ti-check me-1"></i> Güncelle
            </button>
        </div>
    </div>
</form>
