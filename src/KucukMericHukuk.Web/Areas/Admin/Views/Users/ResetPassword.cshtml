@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Users.ResetPasswordFormViewModel
@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="page-header">
    <nav aria-label="breadcrumbs">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Users" asp-area="Admin">Kullanıcılar</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.UserId">@Model.UserName</a></li>
            <li class="breadcrumb-item active">Şifre Sıfırla</li>
        </ol>
    </nav>
    <h2 class="page-title">Şifre Sıfırla: @Model.UserName</h2>
</div>

<form asp-action="ResetPassword" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.UserId"
      method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="card mt-3">
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <strong>Uyarı:</strong> Yeni şifre kullanıcıya iletilmez. Şifreyi siz güvenli bir kanalla
                (telefon, yüz yüze) iletmelisiniz.
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
                <small class="form-hint">En az 8 karakter.</small>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmNewPassword" class="form-label required"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="invalid-feedback d-block"></span>
                <small class="form-hint">Yeni şifreyi tekrar girin (typo koruması).</small>
            </div>
        </div>
        <div class="card-footer d-flex">
            <a asp-action="Details" asp-controller="Users" asp-area="Admin" asp-route-id="@Model.UserId" class="btn btn-link">Vazgeç</a>
            <button type="submit" class="btn btn-warning ms-auto">
                <i class="ti ti-key me-1"></i> Şifre Sıfırla
            </button>
        </div>
    </div>
</form>
