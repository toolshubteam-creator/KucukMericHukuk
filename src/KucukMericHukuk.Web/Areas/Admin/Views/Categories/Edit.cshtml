@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Categories.CategoryFormViewModel
@{
    ViewData["Title"] = "Kategori Düzenle";
    var firstName = Model.Translations?.FirstOrDefault()?.Name ?? "(adsız)";
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Categories" asp-area="Admin">Kategoriler</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-controller="Categories" asp-area="Admin"
                           asp-route-id="@Model.Id">@firstName</a>
                    </li>
                    <li class="breadcrumb-item active">Düzenle</li>
                </ol>
            </nav>
            <h2 class="page-title">Kategori Düzenle: @firstName</h2>
        </div>
    </div>
</div>

@*
    Form body Create ile aynı — 2.10 cleanup'ta ortak _CategoryForm partial'ına refactor.
*@
<form asp-action="Edit" asp-controller="Categories" asp-area="Admin" asp-route-id="@Model.Id"
      method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row mt-3">
        <div class="col-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Genel Bilgiler</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ParentCategoryId" class="form-label"></label>
                        <select asp-for="ParentCategoryId" class="form-select">
                            <option value="">— (Üst kategori yok)</option>
                            @foreach (var p in Model.AvailableParents)
                            {
                                <option value="@p.Id">@Html.Raw(p.Name)</option>
                            }
                        </select>
                        <span asp-validation-for="ParentCategoryId" class="invalid-feedback d-block"></span>
                        <small class="form-hint">Kendisi ve alt kategorileri seçilemez.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="DisplayOrder" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">Aktif</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Çeviriler</h3>
                </div>
                <div class="card-body">
                    <partial name="_CategoryLanguageTabs" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Details" asp-controller="Categories" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-check me-1"></i> Güncelle
        </button>
    </div>
</form>
