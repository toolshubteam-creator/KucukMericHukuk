@model KucukMericHukuk.Core.DTOs.Category.CategoryAdminDto
@{
    ViewData["Title"] = $"Kategori: {Model.Translations?.FirstOrDefault()?.Name ?? "(adsız)"}";
    var firstName = Model.Translations?.FirstOrDefault()?.Name ?? "(adsız)";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Categories" asp-area="Admin">Kategoriler</a>
                    </li>
                    <li class="breadcrumb-item active">@firstName</li>
                </ol>
            </nav>
            <h2 class="page-title">@firstName</h2>
        </div>
        <div class="col-auto">
            @if (!Model.IsDeleted)
            {
                <a asp-action="Edit" asp-controller="Categories" asp-area="Admin"
                   asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i> Düzenle
                </a>
            }
            @* TODO Faz 2.8c — Sil/Geri Yükle/Tamamen Sil butonları *@
            <a href="#" class="btn btn-outline-danger disabled ms-1">
                <i class="ti ti-trash me-1"></i> Sil
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Genel Bilgiler</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Sıra</dt>
                    <dd class="col-7">@Model.DisplayOrder</dd>

                    <dt class="col-5">Durum</dt>
                    <dd class="col-7">
                        @if (Model.IsDeleted)
                        {
                            <span class="badge bg-danger-lt">Silinmiş</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Pasif</span>
                        }
                    </dd>

                    <dt class="col-5">Üst Kategori</dt>
                    <dd class="col-7">
                        @if (Model.ParentCategoryId.HasValue)
                        {
                            <a asp-action="Details" asp-controller="Categories" asp-area="Admin"
                               asp-route-id="@Model.ParentCategoryId.Value">@(string.IsNullOrWhiteSpace(Model.ParentCategoryName) ? "—" : Model.ParentCategoryName)</a>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </dd>

                    <dt class="col-5">Makale Sayısı</dt>
                    <dd class="col-7">@Model.ArticleCount</dd>

                    <dt class="col-5">Oluşturulma</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-5">Güncellenme</dt>
                        <dd class="col-7">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Çeviriler (@(Model.Translations?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Translations is null || Model.Translations.Count == 0)
                {
                    <p class="text-secondary mb-0">Henüz çeviri eklenmemiş.</p>
                }
                else
                {
                    <div class="accordion" id="categoryTranslationsAccordion">
                        @{ var idx = 0; }
                        @foreach (var t in Model.Translations)
                        {
                            var collapseId = $"cattrans-{idx}";
                            <div class="accordion-item">
                                <h4 class="accordion-header">
                                    <button class="accordion-button @(idx > 0 ? "collapsed" : "")"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="@(idx == 0 ? "true" : "false")">
                                        <span class="badge bg-blue-lt me-2">@t.LanguageCode</span>
                                        @t.Name
                                    </button>
                                </h4>
                                <div id="@collapseId"
                                     class="accordion-collapse collapse @(idx == 0 ? "show" : "")"
                                     data-bs-parent="#categoryTranslationsAccordion">
                                    <div class="accordion-body">
                                        <dl class="row mb-0">
                                            <dt class="col-3">Ad</dt>
                                            <dd class="col-9">@t.Name</dd>

                                            <dt class="col-3">Slug</dt>
                                            <dd class="col-9"><code>@t.Slug</code></dd>

                                            <dt class="col-3">Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.Description) ? "—" : t.Description)</dd>

                                            <dt class="col-3">Meta Başlık</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaTitle) ? "—" : t.MetaTitle)</dd>

                                            <dt class="col-3">Meta Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaDescription) ? "—" : t.MetaDescription)</dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
