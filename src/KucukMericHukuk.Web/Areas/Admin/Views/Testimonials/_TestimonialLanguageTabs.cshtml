@using KucukMericHukuk.Core.Constants
@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Testimonials.TestimonialFormViewModel
@{
    var supportedLanguages = LanguageCodes.Supported;
}

<ul class="nav nav-tabs mb-3" role="tablist">
    @{
        var firstTab = true;
        foreach (var lang in supportedLanguages)
        {
            var tabId = $"testimoniallang-{lang.Replace("-", "_")}";
            <li class="nav-item" role="presentation">
                <a class="nav-link @(firstTab ? "active" : "")"
                   data-bs-toggle="tab" href="#@tabId" role="tab">@lang</a>
            </li>
            firstTab = false;
        }
    }
</ul>

<div class="tab-content">
    @{
        var firstPane = true;
        for (var i = 0; i < Model.Translations.Count; i++)
        {
            var t = Model.Translations[i];
            var tabId = $"testimoniallang-{t.LanguageCode.Replace("-", "_")}";

            <div class="tab-pane fade @(firstPane ? "show active" : "")" id="@tabId" role="tabpanel">
                <input type="hidden" asp-for="Translations[i].Id" />
                <input type="hidden" asp-for="Translations[i].LanguageCode" />

                <div class="mb-3">
                    <label asp-for="Translations[i].Content" class="form-label required"></label>
                    <textarea asp-for="Translations[i].Content" class="form-control" rows="6" maxlength="2000"></textarea>
                    <span asp-validation-for="Translations[i].Content" class="invalid-feedback d-block"></span>
                    <small class="form-hint">
                        Düz metin. HTML kullanmayın (otomatik escape edilir).
                        <strong>TBB:</strong> Müvekkil adı, dava numarası, mahkeme veya firma adı yazmayın.
                    </small>
                </div>
            </div>
            firstPane = false;
        }
    }
</div>
