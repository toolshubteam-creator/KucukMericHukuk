@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Testimonials.TestimonialFormViewModel
@{
    ViewData["Title"] = "Müvekkil Yorumu Düzenle";
    var initials = Model.AuthorInitials ?? "(inisyal yok)";
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Testimonials" asp-area="Admin">Müvekkil Yorumları</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-controller="Testimonials" asp-area="Admin"
                           asp-route-id="@Model.Id">@initials</a>
                    </li>
                    <li class="breadcrumb-item active">Düzenle</li>
                </ol>
            </nav>
            <h2 class="page-title">Müvekkil Yorumu Düzenle</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-controller="Testimonials" asp-area="Admin" asp-route-id="@Model.Id"
      method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_TestimonialForm" model="Model" />

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Details" asp-controller="Testimonials" asp-area="Admin"
           asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-check me-1"></i> Güncelle
        </button>
    </div>
</form>
