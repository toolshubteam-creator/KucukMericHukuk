@model KucukMericHukuk.Core.DTOs.Testimonial.TestimonialAdminDto
@{
    ViewData["Title"] = "Müvekkil Yorumu Detayı";
    var initials = Model.AuthorInitials ?? "(inisyal yok)";
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Testimonials" asp-area="Admin">Müvekkil Yorumları</a>
                    </li>
                    <li class="breadcrumb-item active">@initials</li>
                </ol>
            </nav>
            <h2 class="page-title">@initials — @(Model.AuthorRole ?? "Müvekkil")</h2>
        </div>
        <div class="col-auto">
            @if (!Model.IsDeleted)
            {
                <a asp-action="Edit" asp-controller="Testimonials" asp-area="Admin"
                   asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i> Düzenle
                </a>
                <form asp-action="Delete" asp-controller="Testimonials" asp-area="Admin"
                      asp-route-id="@Model.Id" method="post" class="d-inline ms-1"
                      data-confirm="Bu müvekkil yorumunu silmek istediğinizden emin misiniz?"
                      data-confirm-title="Yorum Sil"
                      data-confirm-button="Sil">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="ti ti-trash me-1"></i> Sil
                    </button>
                </form>
            }
            else
            {
                <form asp-action="Restore" asp-controller="Testimonials" asp-area="Admin"
                      asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success">
                        <i class="ti ti-restore me-1"></i> Geri Yükle
                    </button>
                </form>
                <form asp-action="HardDelete" asp-controller="Testimonials" asp-area="Admin"
                      asp-route-id="@Model.Id" method="post" class="d-inline ms-1"
                      data-confirm="Bu müvekkil yorumu KALICI olarak silinecek. Bu işlem GERİ ALINAMAZ. Devam edilsin mi?"
                      data-confirm-title="Kalıcı Silme"
                      data-confirm-button="Tamamen Sil"
                      data-confirm-variant="danger">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="ti ti-x me-1"></i> Tamamen Sil
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="card mt-3">
    <div class="card-header">
        <h3 class="card-title">Yorum Bilgileri</h3>
    </div>
    <div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-3">İnisyal</dt>
            <dd class="col-sm-9">@(Model.AuthorInitials ?? "-")</dd>

            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9">@(Model.AuthorRole ?? "-")</dd>

            <dt class="col-sm-3">Yıldız</dt>
            <dd class="col-sm-9">
                @if (Model.Rating.HasValue)
                {
                    <span>@(new string('★', Model.Rating.Value))<span class="text-secondary">@(new string('☆', 5 - Model.Rating.Value))</span></span>
                    <span class="text-secondary ms-2">(@Model.Rating /5)</span>
                }
                else
                {
                    <span class="text-secondary">-</span>
                }
            </dd>

            <dt class="col-sm-3">Sıra</dt>
            <dd class="col-sm-9">@Model.DisplayOrder</dd>

            <dt class="col-sm-3">Durum</dt>
            <dd class="col-sm-9">
                @if (Model.IsDeleted)
                {
                    <span class="badge bg-danger-lt">Silinmiş</span>
                }
                else if (Model.IsActive)
                {
                    <span class="badge bg-success-lt">Aktif</span>
                    if (Model.IsFeatured)
                    {
                        <span class="badge bg-yellow-lt ms-1">Öne Çıkan (Ana Sayfa)</span>
                    }
                }
                else
                {
                    <span class="badge bg-secondary-lt">Pasif</span>
                }
            </dd>

            <dt class="col-sm-3">Oluşturulma</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

            @if (Model.UpdatedAt.HasValue)
            {
                <dt class="col-sm-3">Güncellenme</dt>
                <dd class="col-sm-9">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
            }
        </dl>

        <h4 class="mt-4">Yorum İçeriği (@(Model.Translations?.Count ?? 0))</h4>

        @if (Model.Translations is null || Model.Translations.Count == 0)
        {
            <p class="text-secondary mb-0">Henüz çeviri eklenmemiş.</p>
        }
        else
        {
            <div class="accordion" id="testimonialTranslationsAccordion">
                @{ var idx = 0; }
                @foreach (var t in Model.Translations)
                {
                    var collapseId = $"testtrans-{idx}";
                    <div class="accordion-item">
                        <h5 class="accordion-header">
                            <button class="accordion-button @(idx > 0 ? "collapsed" : "")"
                                    type="button" data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(idx == 0 ? "true" : "false")">
                                <span class="badge bg-blue-lt me-2">@t.LanguageCode</span>
                                @(t.Content.Length > 60 ? t.Content[..60] + "..." : t.Content)
                            </button>
                        </h5>
                        <div id="@collapseId"
                             class="accordion-collapse collapse @(idx == 0 ? "show" : "")"
                             data-bs-parent="#testimonialTranslationsAccordion">
                            <div class="accordion-body">
                                <p style="white-space: pre-wrap;" class="mb-0">@t.Content</p>
                            </div>
                        </div>
                    </div>
                    idx++;
                }
            </div>
        }
    </div>
</div>
