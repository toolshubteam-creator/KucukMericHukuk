@model KucukMericHukuk.Core.DTOs.Contact.ContactMessageAdminDto
@inject Microsoft.Extensions.Options.IOptions<KucukMericHukuk.Infrastructure.Email.EmailSettings> EmailOptions
@{
    ViewData["Title"] = $"Mesaj #{Model.Id}";
    var mailtoSubject = Uri.EscapeDataString("RE: " + Model.Subject);
    var smtpConfigured = !string.IsNullOrWhiteSpace(EmailOptions.Value.SmtpHost);
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="ContactMessages" asp-area="Admin">İletişim Mesajları</a>
                    </li>
                    <li class="breadcrumb-item active">@Model.Subject</li>
                </ol>
            </nav>
            <h2 class="page-title">@Model.Subject</h2>
            <div class="text-secondary mt-1">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
        </div>
        <div class="col-auto">
            <a asp-action="Index" asp-controller="ContactMessages" asp-area="Admin" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
                    @if (Model.IsDeleted)
                    {
                        <span class="badge bg-danger-lt">Silinmiş</span>
                    }
                    else if (Model.IsAnswered)
                    {
                        <span class="badge bg-success-lt">Yanıtlandı</span>
                    }
                    else if (Model.IsRead)
                    {
                        <span class="badge bg-info-lt">Okundu</span>
                    }
                    else
                    {
                        <span class="badge bg-warning-lt">Yeni</span>
                    }

                    @if (Model.KvkkConsent)
                    {
                        <span class="badge bg-secondary-lt">KVKK Onaylandı</span>
                    }
                </div>

                <h4>Mesaj</h4>
                <div class="message-body p-3 bg-light rounded" style="white-space: pre-wrap;">@Model.Message</div>

                <div class="mt-4 d-flex gap-2 flex-wrap">
                    @if (!Model.IsDeleted)
                    {
                        <a href="mailto:@(Model.Email)?subject=@mailtoSubject" class="btn btn-outline-primary">
                            <i class="ti ti-external-link me-1"></i> Dış E-posta İstemcisi
                        </a>
                        <form asp-action="ToggleAnswered" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (Model.IsAnswered)
                            {
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="ti ti-x me-1"></i> Yanıtlanmadı işaretle
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success">
                                    <i class="ti ti-check me-1"></i> Yanıtlandı işaretle
                                </button>
                            }
                        </form>
                        <form asp-action="Delete" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline"
                              data-confirm="Bu mesajı silmek istediğinizden emin misiniz? Daha sonra geri yükleyebilirsiniz."
                              data-confirm-title="Mesajı Sil"
                              data-confirm-button="Sil">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-trash me-1"></i> Sil
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Restore" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success">
                                <i class="ti ti-restore me-1"></i> Geri Yükle
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @if (!Model.IsDeleted)
        {
            @* Faz 6.7: In-app reply formu *@
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title mb-0">Yanıt Yaz</h3>
                </div>
                <div class="card-body">
                    @if (!smtpConfigured)
                    {
                        <div class="alert alert-warning" role="alert">
                            <strong>SMTP yapılandırılmamış:</strong> Yanıt kaydedilir ancak müvekkile e-posta gönderilmez.
                            <code>EmailSettings:SmtpHost</code> appsettings veya environment variable ile tanımlayın.
                        </div>
                    }
                    <form asp-action="Reply" asp-controller="ContactMessages" asp-area="Admin"
                          asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="reply-body" class="form-label">Yanıt metni</label>
                            <textarea id="reply-body" name="body" class="form-control" rows="6"
                                      maxlength="4000" required
                                      placeholder="Müvekkile gidecek yanıt metnini yazın..."></textarea>
                            <small class="text-secondary">Düz metin. Müvekkilin e-posta adresine gönderilir, IsAnswered=true olarak işaretlenir.</small>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-send me-1"></i> Yanıt Gönder
                        </button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Replies.Any())
        {
            @* Faz 6.7: Yanıt geçmişi *@
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title mb-0">Yanıt Geçmişi (@Model.Replies.Count)</h3>
                </div>
                <div class="card-body">
                    @foreach (var r in Model.Replies)
                    {
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between mb-1">
                                <strong>@(r.SentByUserName ?? "(silinmiş kullanıcı)")</strong>
                                <small class="text-secondary">@r.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <div style="white-space: pre-wrap;">@r.Body</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title mb-0">Gönderen Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <dt class="col-sm-4">Telefon</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title mb-0">Teknik Bilgiler</h3></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">IP Adresi</dt>
                    <dd class="col-sm-7">@(Model.IpAddress ?? "-")</dd>

                    <dt class="col-sm-5">Tarayıcı</dt>
                    <dd class="col-sm-7" style="word-break: break-all">@(Model.UserAgent ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
