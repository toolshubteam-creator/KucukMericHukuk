@model KucukMericHukuk.Core.DTOs.Contact.ContactMessageAdminDto
@{
    ViewData["Title"] = $"Mesaj #{Model.Id}";
    var mailtoSubject = Uri.EscapeDataString("RE: " + Model.Subject);
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="ContactMessages" asp-area="Admin">İletişim Mesajları</a>
                    </li>
                    <li class="breadcrumb-item active">@Model.Subject</li>
                </ol>
            </nav>
            <h2 class="page-title">@Model.Subject</h2>
            <div class="text-secondary mt-1">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</div>
        </div>
        <div class="col-auto">
            <a asp-action="Index" asp-controller="ContactMessages" asp-area="Admin" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-1"></i> Geri
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] is string okMsg)
{
    <div class="alert alert-success mt-3" role="alert">@okMsg</div>
}
@if (TempData["Error"] is string errMsg)
{
    <div class="alert alert-danger mt-3" role="alert">@errMsg</div>
}

<div class="row mt-3">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="mb-3 d-flex gap-2 align-items-center flex-wrap">
                    @if (Model.IsDeleted)
                    {
                        <span class="badge bg-danger-lt">Silinmiş</span>
                    }
                    else if (Model.IsAnswered)
                    {
                        <span class="badge bg-success-lt">Yanıtlandı</span>
                    }
                    else if (Model.IsRead)
                    {
                        <span class="badge bg-info-lt">Okundu</span>
                    }
                    else
                    {
                        <span class="badge bg-warning-lt">Yeni</span>
                    }

                    @if (Model.KvkkConsent)
                    {
                        <span class="badge bg-secondary-lt">KVKK Onaylandı</span>
                    }
                </div>

                <h4>Mesaj</h4>
                <div class="message-body p-3 bg-light rounded" style="white-space: pre-wrap;">@Model.Message</div>

                <div class="mt-4 d-flex gap-2 flex-wrap">
                    @if (!Model.IsDeleted)
                    {
                        <a href="mailto:@(Model.Email)?subject=@mailtoSubject" class="btn btn-primary">
                            <i class="ti ti-mail-forward me-1"></i> E-posta ile Yanıtla
                        </a>
                        <form asp-action="ToggleAnswered" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            @if (Model.IsAnswered)
                            {
                                <button type="submit" class="btn btn-outline-secondary">
                                    <i class="ti ti-x me-1"></i> Yanıtlanmadı işaretle
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-success">
                                    <i class="ti ti-check me-1"></i> Yanıtlandı işaretle
                                </button>
                            }
                        </form>
                        <form asp-action="Delete" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline"
                              data-confirm="Bu mesajı silmek istediğinizden emin misiniz? Daha sonra geri yükleyebilirsiniz."
                              data-confirm-title="Mesajı Sil"
                              data-confirm-button="Sil">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-trash me-1"></i> Sil
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Restore" asp-controller="ContactMessages" asp-area="Admin"
                              asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-success">
                                <i class="ti ti-restore me-1"></i> Geri Yükle
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><h3 class="card-title mb-0">Gönderen Bilgileri</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <dt class="col-sm-4">Telefon</dt>
                        <dd class="col-sm-8">@Model.Phone</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title mb-0">Teknik Bilgiler</h3></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">IP Adresi</dt>
                    <dd class="col-sm-7">@(Model.IpAddress ?? "-")</dd>

                    <dt class="col-sm-5">Tarayıcı</dt>
                    <dd class="col-sm-7" style="word-break: break-all">@(Model.UserAgent ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
