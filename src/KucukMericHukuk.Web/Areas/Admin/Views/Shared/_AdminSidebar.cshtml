@*
    Sidebar. Aktif state controller-bazlı (Helpers/SidebarHelpers.IsActiveController).
    Faz 6.10: Role-based visibility — Admin tüm modülleri; Editor ve Author sadece
    Dashboard + Articles + Profilim + Çıkış görür. Editor tüm makaleleri,
    Author sadece kendi makalelerini düzenleyebilir (ArticlesController authz).
*@
<aside class="navbar navbar-vertical navbar-expand-lg navbar-dark">
    <div class="container-fluid">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <h1 class="navbar-brand navbar-brand-autodark">
            <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="navbar-brand-image-text">
                Küçükmeriç Hukuk
            </a>
        </h1>
        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Admin" asp-action="Index">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-dashboard"></i>
                        </span>
                        <span class="nav-link-title">Kontrol Paneli</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @Html.IsActiveController("Articles")" asp-action="Index" asp-controller="Articles" asp-area="Admin">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-article"></i>
                        </span>
                        <span class="nav-link-title">Makaleler</span>
                    </a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Pages")" asp-action="Index" asp-controller="Pages" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-file-text"></i>
                            </span>
                            <span class="nav-link-title">Sayfalar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Services")" asp-action="Index" asp-controller="Services" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-briefcase"></i>
                            </span>
                            <span class="nav-link-title">Hizmetler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Attorneys")" asp-action="Index" asp-controller="Attorneys" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-users"></i>
                            </span>
                            <span class="nav-link-title">Avukatlarımız</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Categories")" asp-action="Index" asp-controller="Categories" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-category"></i>
                            </span>
                            <span class="nav-link-title">Kategoriler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Tags")" asp-action="Index" asp-controller="Tags" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-tag"></i>
                            </span>
                            <span class="nav-link-title">Etiketler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Medias")" asp-action="Index" asp-controller="Medias" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-photo"></i>
                            </span>
                            <span class="nav-link-title">Medya</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Faqs")" asp-action="Index" asp-controller="Faqs" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-message-question"></i>
                            </span>
                            <span class="nav-link-title">SSS</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("ContactMessages")" asp-action="Index" asp-controller="ContactMessages" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-mail"></i>
                            </span>
                            <span class="nav-link-title">Mesajlar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Appointments")" asp-action="Index" asp-controller="Appointments" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-calendar-event"></i>
                            </span>
                            <span class="nav-link-title">Randevular</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Subscribers")" asp-action="Index" asp-controller="Subscribers" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-users-group"></i>
                            </span>
                            <span class="nav-link-title">Aboneler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Newsletter")" asp-action="Index" asp-controller="Newsletter" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-mail-forward"></i>
                            </span>
                            <span class="nav-link-title">Bülten</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Testimonials")" asp-action="Index" asp-controller="Testimonials" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-star"></i>
                            </span>
                            <span class="nav-link-title">Referanslar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("AuditLogs")" asp-action="Index" asp-controller="AuditLogs" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-history"></i>
                            </span>
                            <span class="nav-link-title">Aktivite Logu</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("NotFoundLogs")" asp-action="Index" asp-controller="NotFoundLogs" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-link-off"></i>
                            </span>
                            <span class="nav-link-title">404 Kayıtları</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Redirects")" asp-action="Index" asp-controller="Redirects" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-arrow-forward"></i>
                            </span>
                            <span class="nav-link-title">Yönlendirmeler</span>
                        </a>
                    </li>
                    <li class="nav-item my-2 px-3"><hr class="sidebar-divider" /></li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("Users")" asp-action="Index" asp-controller="Users" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-user-shield"></i>
                            </span>
                            <span class="nav-link-title">Kullanıcılar</span>
                        </a>
                    </li>
                    <li class="nav-item my-2 px-3"><hr class="sidebar-divider" /></li>
                    <li class="nav-item">
                        <a class="nav-link @Html.IsActiveController("SiteSettings")" asp-action="Index" asp-controller="SiteSettings" asp-area="Admin">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-settings"></i>
                            </span>
                            <span class="nav-link-title">Site Ayarları</span>
                        </a>
                    </li>
                }
                @* Faz 6.8: Profilim + Çıkış (sidebar altı — dropdown bug bypass) *@
                <li class="nav-item my-2 px-3"><hr class="sidebar-divider" /></li>
                <li class="nav-item">
                    <a class="nav-link @Html.IsActiveController("Account")"
                       asp-area="Admin" asp-controller="Account" asp-action="Profile">
                        <span class="nav-link-icon d-md-none d-lg-inline-block">
                            <i class="ti ti-user-circle"></i>
                        </span>
                        <span class="nav-link-title">Profilim</span>
                    </a>
                </li>
                <li class="nav-item">
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link border-0 bg-transparent w-100 text-start">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-logout"></i>
                            </span>
                            <span class="nav-link-title">Çıkış Yap</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</aside>
