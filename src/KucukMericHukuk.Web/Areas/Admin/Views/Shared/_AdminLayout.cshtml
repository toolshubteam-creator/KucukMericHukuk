@*
    Tabler.io v1.4.0 — pinned 2026-05-05
    Tabler icons-webfont v3.42.0 — pinned 2026-05-05
    Inline CSS yasaktır; tüm stiller wwwroot/css/admin/admin.css ve components/'tadır.
*@
<!DOCTYPE html>
<html lang="tr" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Yönetim Paneli") — Küçükmeriç Hukuk</title>
    @* Faz 6.23: Tasarım token'ları — ilk CSS, admin.css + components bunun üzerine kurulur *@
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    @* Tabler core CSS — 1.4.0 self-host (Faz 6.17, libman) *@
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" asp-append-version="true" />
    @* Tabler icons-webfont — 3.42.0 self-host (Faz 6.17, libman) *@
    <link rel="stylesheet" href="~/lib/tabler-icons/dist/tabler-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/medias.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/components/quill-editor.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="page">
        <partial name="_AdminSidebar" />
        <div class="page-wrapper">
            <partial name="_AdminTopbar" />
            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>
            <partial name="_AdminFooter" />
        </div>
    </div>
    @* Tabler core JS — 1.4.0 self-host (Faz 6.17) *@
    <script src="~/lib/tabler/dist/js/tabler.min.js" asp-append-version="true"></script>
    @* Bootstrap JS bundle — 5.3.3 self-host (Faz 6.17) *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @* SweetAlert2 — 11.26.24 self-host (Faz 6.17) *@
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-topbar.js" asp-append-version="true"></script>
    <script src="~/js/admin/sweet-alert-init.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
