@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Pages.PageFormViewModel
@{
    ViewData["Title"] = "Sayfa Düzenle";
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.snow.css" />
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Pages" asp-area="Admin">Sayfalar</a>
                    </li>
                    <li class="breadcrumb-item">
                        <a asp-action="Details" asp-controller="Pages" asp-area="Admin" asp-route-id="@Model.Id">@Model.PageKey</a>
                    </li>
                    <li class="breadcrumb-item active">Düzenle</li>
                </ol>
            </nav>
            <h2 class="page-title">Sayfa Düzenle: @Model.PageKey</h2>
        </div>
    </div>
</div>

<form asp-action="Edit" asp-controller="Pages" asp-area="Admin" asp-route-id="@Model.Id"
      method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <partial name="_PageForm" model="Model" />

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Details" asp-controller="Pages" asp-area="Admin" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-check me-1"></i> Güncelle
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.js"></script>
    <script src="~/js/admin/quill-init.js" asp-append-version="true"></script>
}
