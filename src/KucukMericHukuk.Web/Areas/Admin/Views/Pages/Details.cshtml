@model KucukMericHukuk.Core.DTOs.Page.PageAdminDto
@{
    ViewData["Title"] = $"Sayfa: {Model.PageKey}";
    var firstTitle = Model.Translations?.FirstOrDefault()?.Title ?? "(başlıksız)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/components/page-details.css" asp-append-version="true" />
}

<div class="page-header d-print-none">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Pages" asp-area="Admin">Sayfalar</a>
                    </li>
                    <li class="breadcrumb-item active">@firstTitle</li>
                </ol>
            </nav>
            <h2 class="page-title">@firstTitle</h2>
        </div>
        <div class="col-auto">
            @* TODO Faz 2.5c — Düzenle butonu aktif edilecek *@
            <a href="#" class="btn btn-primary disabled">
                <i class="ti ti-edit me-1"></i> Düzenle
            </a>
            @if (Model.IsDeleted)
            {
                @* TODO Faz 2.5c — Restore + HardDelete butonları *@
                <a href="#" class="btn btn-outline-success disabled ms-1">
                    <i class="ti ti-restore me-1"></i> Geri Yükle
                </a>
            }
            else
            {
                @* TODO Faz 2.5c — Soft delete butonu *@
                <a href="#" class="btn btn-outline-danger disabled ms-1">
                    <i class="ti ti-trash me-1"></i> Sil
                </a>
            }
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12 col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Genel Bilgiler</h3>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5">Anahtar</dt>
                    <dd class="col-7"><code>@Model.PageKey</code></dd>

                    <dt class="col-5">Sıra</dt>
                    <dd class="col-7">@Model.DisplayOrder</dd>

                    <dt class="col-5">Durum</dt>
                    <dd class="col-7">
                        @if (Model.IsDeleted)
                        {
                            <span class="badge bg-danger-lt">Silinmiş</span>
                        }
                        else if (Model.IsActive)
                        {
                            <span class="badge bg-success-lt">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-lt">Pasif</span>
                        }
                    </dd>

                    <dt class="col-5">Sistem Sayfası</dt>
                    <dd class="col-7">@(Model.IsSystem ? "Evet" : "Hayır")</dd>

                    <dt class="col-5">Oluşturulma</dt>
                    <dd class="col-7">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <dt class="col-5">Güncellenme</dt>
                        <dd class="col-7">@Model.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Çeviriler (@(Model.Translations?.Count ?? 0))</h3>
            </div>
            <div class="card-body">
                @if (Model.Translations is null || Model.Translations.Count == 0)
                {
                    <p class="text-secondary mb-0">Henüz çeviri eklenmemiş.</p>
                }
                else
                {
                    <div class="accordion" id="translationsAccordion">
                        @{ var idx = 0; }
                        @foreach (var t in Model.Translations)
                        {
                            var collapseId = $"trans-{idx}";
                            <div class="accordion-item">
                                <h4 class="accordion-header">
                                    <button class="accordion-button @(idx > 0 ? "collapsed" : "")"
                                            type="button" data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="@(idx == 0 ? "true" : "false")">
                                        <span class="badge bg-blue-lt me-2">@t.LanguageCode</span>
                                        @t.Title
                                    </button>
                                </h4>
                                <div id="@collapseId"
                                     class="accordion-collapse collapse @(idx == 0 ? "show" : "")"
                                     data-bs-parent="#translationsAccordion">
                                    <div class="accordion-body">
                                        <dl class="row">
                                            <dt class="col-3">Başlık</dt>
                                            <dd class="col-9">@t.Title</dd>

                                            <dt class="col-3">Slug</dt>
                                            <dd class="col-9"><code>@t.Slug</code></dd>

                                            <dt class="col-3">Meta Başlık</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaTitle) ? "—" : t.MetaTitle)</dd>

                                            <dt class="col-3">Meta Açıklama</dt>
                                            <dd class="col-9">@(string.IsNullOrWhiteSpace(t.MetaDescription) ? "—" : t.MetaDescription)</dd>

                                            <dt class="col-3">İçerik</dt>
                                            <dd class="col-9">
                                                @* İçerik şu an plain string — 2.5c'de Quill HTML olacak.
                                                   XSS riski olmasın diye Razor'un default HTML encoding'ine bırakıyoruz.
                                                   2.5c'de HtmlSanitizer'dan geçince Html.Raw güvenli olur. *@
                                                <div class="border rounded p-2 bg-light">
                                                    <pre class="page-content-preview">@t.Content</pre>
                                                </div>
                                            </dd>
                                        </dl>
                                    </div>
                                </div>
                            </div>
                            idx++;
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
