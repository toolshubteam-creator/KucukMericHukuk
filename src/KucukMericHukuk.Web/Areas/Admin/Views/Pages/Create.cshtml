@model KucukMericHukuk.Web.Areas.Admin.ViewModels.Pages.PageFormViewModel
@{
    ViewData["Title"] = "Yeni Sayfa";
}

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.snow.css" />
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <nav aria-label="breadcrumbs">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" asp-controller="Pages" asp-area="Admin">Sayfalar</a>
                    </li>
                    <li class="breadcrumb-item active">Yeni Sayfa</li>
                </ol>
            </nav>
            <h2 class="page-title">Yeni Sayfa</h2>
        </div>
    </div>
</div>

<form asp-action="Create" asp-controller="Pages" asp-area="Admin" method="post" autocomplete="off" novalidate>
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row mt-3">
        <div class="col-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Genel Bilgiler</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="PageKey" class="form-label required"></label>
                        <input asp-for="PageKey" class="form-control" placeholder="ornek-sayfa" />
                        <span asp-validation-for="PageKey" class="invalid-feedback d-block"></span>
                        <small class="form-hint">Yalnızca küçük harf, rakam ve tire.</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="DisplayOrder" class="invalid-feedback d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" />
                            <span class="form-check-label">Aktif</span>
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-check form-switch">
                            <input asp-for="IsSystem" class="form-check-input" />
                            <span class="form-check-label">Sistem Sayfası</span>
                        </label>
                        <small class="form-hint d-block">Sistem sayfaları silinemez (gelecekte uygulanacak).</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Çeviriler</h3>
                </div>
                <div class="card-body">
                    <partial name="_PageLanguageTabs" model="Model" />
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer mt-3 d-flex">
        <a asp-action="Index" asp-controller="Pages" asp-area="Admin" class="btn btn-link">Vazgeç</a>
        <button type="submit" class="btn btn-primary ms-auto">
            <i class="ti ti-plus me-1"></i> Oluştur
        </button>
    </div>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@@2.0.3/dist/quill.js"></script>
    <script src="~/js/admin/quill-init.js" asp-append-version="true"></script>
}
