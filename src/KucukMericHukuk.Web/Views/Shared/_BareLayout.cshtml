@* Faz 4.1'de oluşturulur, kullanılmaz. Faz 4.9'da 404/500'e bağlanacak.
   Chrome'suz: header + footer YOK. Sadece token, font, Bootstrap reset. *@
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Html.MetaTags()

    @* Faz 6.14: Google Fonts self-host (bkz. _PublicLayout) *@
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />

    @* Bootstrap CSS — 5.3.3 self-host (Faz 6.17) *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site/site.css" asp-append-version="true" />
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    @* Bootstrap JS bundle — 5.3.3 self-host (Faz 6.17) *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site/site.js" asp-append-version="true"></script>
</body>
</html>
