@* Faz 4.6: footer alt linkler eklendi (KVKK, Çerez, Kullanım) *@
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<footer class="site-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <p class="mb-1"><strong>Küçükmeriç Hukuk Bürosu</strong></p>
                <p class="mb-0 small">Serdivan / Sakarya</p>
            </div>
            <div class="col-md-6 text-md-end">
                <p class="mb-1 small">&copy; @DateTime.Now.Year Tüm hakları saklıdır.</p>
                <p class="mb-0 small">
                    <a asp-controller="Pages" asp-action="Detail" asp-route-culture="@culture" asp-route-slug="gizlilik">KVKK</a>
                    <span class="mx-1">·</span>
                    <a asp-controller="Pages" asp-action="Detail" asp-route-culture="@culture" asp-route-slug="cerez-politikasi">Çerez</a>
                    <span class="mx-1">·</span>
                    <a asp-controller="Pages" asp-action="Detail" asp-route-culture="@culture" asp-route-slug="kullanim-kosullari">Kullanım</a>
                </p>
            </div>
        </div>
    </div>
</footer>
