@inject KucukMericHukuk.Core.Interfaces.Services.IJsonLdService JsonLd
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Html.MetaTags()

    @* Faz 6.14: Google Fonts self-host. wwwroot/fonts/ altında 12 woff2 (Playfair 3w + Inter 3w × latin+latin-ext).
       Google CDN'e preconnect kaldırıldı, render-blocking 889ms tasarruf. *@
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />

    @* Bootstrap CSS — 5.3.3 jsdelivr + sha384 SRI (Faz 5.5) *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <link rel="stylesheet" href="~/css/site/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)

    @* Site-wide JSON-LD schema *@
    @Html.JsonLd(JsonLd.BuildLegalService())
    @Html.JsonLd(JsonLd.BuildWebSite())
</head>
<body>
    <partial name="_SiteHeader" />

    <main role="main">
        <partial name="_Breadcrumb" />
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <partial name="_CookieConsent" />

    @* Faz 6.14: Tüm public script'ler defer — parser HTML parse ederken parallel download,
       DOMContentLoaded sonrası exec. Body sonunda olmaları sıralı garantili. *@
    @* Bootstrap JS bundle — 5.3.3 + sha384 SRI (Faz 5.5) *@
    <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @* Lucide icons — 1.14.0 pin + sha384 SRI (Faz 5.5; @@latest tag yerine pinli sürüm) *@
    <script defer src="https://unpkg.com/lucide@@1.14.0/dist/umd/lucide.min.js"
            integrity="sha384-jB6ZXxyEV94yzTxgLMvrwwNbn/pTTqwrMDI+v8FV5o5FnId/yn3DJwSdrDujU9A7"
            crossorigin="anonymous"></script>
    <script defer src="~/js/site/site.js" asp-append-version="true"></script>
    <script defer src="~/js/site/cookie-consent.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
