@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Küçükmeriç Hukuk Bürosu")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    @* Bootstrap CSS — 5.3.3 jsdelivr, SRI'siz (admin politikasıyla tutarlı, Faz 5 OWASP turunda SRI eklenecek) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <partial name="_SiteHeader" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    @* Bootstrap JS bundle — admin layout ile birebir aynı *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
