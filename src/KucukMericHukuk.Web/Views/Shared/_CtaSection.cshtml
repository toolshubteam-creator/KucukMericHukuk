@* Faz 4.2: CTA placeholder. Faz 6.22: "Randevu Alın" linki randevu formuna bağlandı. *@
@{
    var ctaCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
}
<section class="cta-section" data-fade-up>
    <div class="container">
        <h2 class="cta-section__title">Hukuki desteğe mi ihtiyacınız var?</h2>
        <p class="cta-section__subtitle">
            Davanız veya hukuki sürecinizle ilgili profesyonel görüş almak için bizimle iletişime geçin.
        </p>
        <a asp-controller="Appointment" asp-action="Index" asp-route-culture="@ctaCulture"
           class="btn-accent">Randevu Alın</a>
    </div>
</section>
